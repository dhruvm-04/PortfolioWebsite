{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/echolang",
      "destination": "/echolang/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/echolang/",
      "destination": "https://echolanggnani.onrender.com/"
    },
    {
      "source": "/echolang/presentation",
      "destination": "https://echolanggnani.onrender.com/presentation.html"
    },
    {
      "source": "/echolang/:path*",
      "destination": "https://echolanggnani.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
